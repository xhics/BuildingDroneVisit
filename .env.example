# Noms de variables, sans valeur (plan directeur §6).
# Copier vers .env — jamais committé.

GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
MAPILLARY_TOKEN=
VISION_API_KEY=

# Mode simple (simple_mode/) — plan de vol et illustration via OpenAI
OPENAI_API_KEY=
# Optionnels : sinon gpt-4o-mini / gpt-image-1 par défaut
OPENAI_MODEL=
OPENAI_IMAGE_MODEL=

# Mode simple — génération vidéo via Sogni (simple_mode/sogni_client.py)
# Schéma de requête non encore confirmé, voir le docstring de ce module.
SOGNI_API_KEY=

# VM GPU (complément d'implémentation §2)
RUNPOD_API_KEY=

# Racine des espaces de travail. Sur la VM GPU, pointer vers le Container Disk.
# HOTEL_PIPELINE_WORK=/workspace/work

# Sources complémentaires (optionnelles)
TRIPADVISOR_API_KEY=
FLICKR_API_KEY=
